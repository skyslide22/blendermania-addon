<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>blendermania_dotnet</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AssetsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', 'assets', 'dotnet'))</AssetsDir>
	</PropertyGroup>

	<!-- Release: dotnet publish -> assets/dotnet/release/ -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
		<DebugType>none</DebugType>
		<PublishDir>$(AssetsDir)release\</PublishDir>
	</PropertyGroup>

	<!-- Debug: every build is copied to assets/dotnet/debug/ -->
	<Target Name="CopyDebugToAssets" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<ItemGroup>
			<_DebugFiles Include="$(OutDir)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(_DebugFiles)"
		      DestinationFiles="@(_DebugFiles->'$(AssetsDir)debug\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>
	
  <ItemGroup>
    <PackageReference Include="GBX.NET" Version="2.4.5" />
    <PackageReference Include="GBX.NET.Imaging" Version="2.0.3" />
    <PackageReference Include="GBX.NET.Json" Version="0.1.7" />
    <PackageReference Include="GBX.NET.LZO" Version="2.1.6" />
    <PackageReference Include="TM_CSharpMapping" Version="0.4.1-alpha.10" />
    
    <!-- TGA & DDS Library -->
    <!-- <PackageReference Include="Pfim" Version="0.11.3" />  -->
    <!-- TGA & DDS Library -->
  
  </ItemGroup>

</Project>
