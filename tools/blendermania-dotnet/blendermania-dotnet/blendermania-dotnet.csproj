<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>blendermania_dotnet</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AssetsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', 'assets', 'dotnet'))</AssetsDir>
	</PropertyGroup>

	<!-- Release: dotnet publish -> assets/dotnet/release/ -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
		<DebugType>none</DebugType>
		<PublishDir>$(AssetsDir)release\</PublishDir>
	</PropertyGroup>

	<!-- Debug: every build is copied to assets/dotnet/debug/ -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
  		<OutputPath>$(AssetsDir)debug\</OutputPath>
  		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>
	
	<!-- <ItemGroup>
  	<ProjectReference Include="F:\Development\Projects\Visual Studio\TM_Projects\TM_GenericMapping\TM_GenericMapping.csproj" />
	</ItemGroup> -->

